{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build API Only",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/MyFirstRestAPI_Project/MyFirstRestAPI_Project.csproj"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Build only the API project"
        },
        {
            "label": "Build Client Only",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/StudentApi.Client/StudentApi.Client.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Build only the Client project"
        }
    ]
}